<%- include('../partials/head') %>
<section class="min-h-[70vh] flex items-center justify-center px-4 py-16">
  <div class="w-full max-w-md bg-white rounded-[2rem] border border-gray-100 shadow-soft p-8">
    <div class="w-12 h-12 rounded-2xl bg-brand-600 text-white flex items-center justify-center font-black mb-6">W</div>
    <p class="text-brand-600 font-black tracking-[.2em] uppercase text-xs mb-3">Admin</p>
    <h1 class="text-4xl font-black tracking-tight text-gray-950 mb-3">Sign in</h1>
    <p class="text-sm text-gray-500 leading-6 mb-6">Manage seller submissions, buyer requests, machine status, and contact introductions.</p>
    <% if (error) { %><div class="bg-red-50 border border-red-200 text-red-700 rounded-2xl p-4 text-sm font-semibold mb-5"><%= error %></div><% } %>
    <form method="post" action="/admin/login" autocomplete="on" class="space-y-4">
      <label class="wpe-field">Email<input type="email" name="email" autocomplete="username" required></label>
      <label class="wpe-field">Password<input type="password" name="password" autocomplete="current-password" required></label>
      <button class="w-full rounded-full bg-brand-600 text-white py-3.5 font-black hover:bg-brand-700 shadow-lg shadow-brand-600/20 transition" type="submit">Sign in</button>
    </form>
  </div>
</section>
<%- include('../partials/foot') %>
