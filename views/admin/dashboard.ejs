<%- include('../partials/head') %>
<% const activeAdmin = 'dashboard'; %>
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-14">
  <div class="rounded-[2rem] bg-gray-950 text-white p-7 md:p-10 mb-6 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
    <div>
      <p class="text-brand-300 font-black tracking-[.2em] uppercase text-xs mb-3">Admin</p>
      <h1 class="text-4xl md:text-5xl font-black tracking-tight mb-3">Dashboard</h1>
      <p class="text-gray-300">Manage listings, buyer requests, and introductions in one place.</p>
    </div>
    <div class="flex flex-wrap gap-3 items-center">
      <span class="px-4 py-2 rounded-full text-sm font-black <%= mailConfigured ? 'bg-green-500/15 text-green-200 border border-green-400/30' : 'bg-amber-500/15 text-amber-200 border border-amber-400/30' %>"><%= mailConfigured ? 'Email ready' : 'Email not configured' %></span>
      <form method="post" action="/admin/logout"><button class="px-4 py-2 rounded-full bg-white text-gray-950 text-sm font-black hover:bg-gray-100 transition" type="submit">Logout</button></form>
    </div>
  </div>
  
  <nav class="flex flex-wrap gap-2 mb-8">
    <a class="px-4 py-2 rounded-full text-sm font-black <%= activeAdmin === 'dashboard' ? 'bg-brand-600 text-white' : 'bg-white border border-gray-200 text-gray-700 hover:bg-gray-50' %>" href="/admin">Dashboard</a>
    <a class="px-4 py-2 rounded-full text-sm font-black <%= activeAdmin === 'machines' ? 'bg-brand-600 text-white' : 'bg-white border border-gray-200 text-gray-700 hover:bg-gray-50' %>" href="/admin/machines">Machines</a>
    <a class="px-4 py-2 rounded-full text-sm font-black <%= activeAdmin === 'requests' ? 'bg-brand-600 text-white' : 'bg-white border border-gray-200 text-gray-700 hover:bg-gray-50' %>" href="/admin/requests">Buyer Requests</a>
  </nav>

  <section class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
    <a class="bg-white rounded-[2rem] border border-gray-100 shadow-sm p-6 hover:shadow-soft transition" href="/admin/machines?status=pending_review"><span class="text-4xl font-black text-brand-600"><%= (machineCounts.find(r => r.status === 'pending_review') || {}).count || 0 %></span><strong class="block mt-3 text-gray-950">Pending review</strong><small class="text-gray-500">Seller submissions waiting for review.</small></a>
    <a class="bg-white rounded-[2rem] border border-gray-100 shadow-sm p-6 hover:shadow-soft transition" href="/admin/machines?status=available"><span class="text-4xl font-black text-gray-950"><%= (machineCounts.find(r => r.status === 'available') || {}).count || 0 %></span><strong class="block mt-3 text-gray-950">Available listings</strong><small class="text-gray-500">Machines currently visible to buyers.</small></a>
    <a class="bg-white rounded-[2rem] border border-gray-100 shadow-sm p-6 hover:shadow-soft transition" href="/admin/requests?status=new"><span class="text-4xl font-black text-gray-950"><%= (requestCounts.find(r => r.status === 'new') || {}).count || 0 %></span><strong class="block mt-3 text-gray-950">New requests</strong><small class="text-gray-500">Buyer requests that need attention.</small></a>
    <a class="bg-white rounded-[2rem] border border-gray-100 shadow-sm p-6 hover:shadow-soft transition" href="/admin/requests?status=matched"><span class="text-4xl font-black text-gray-950"><%= (requestCounts.find(r => r.status === 'matched') || {}).count || 0 %></span><strong class="block mt-3 text-gray-950">Matched</strong><small class="text-gray-500">Introductions already sent.</small></a>
  </section>
  <section class="grid lg:grid-cols-2 gap-6">
    <div class="bg-white rounded-[2rem] border border-gray-100 shadow-sm overflow-hidden">
      <div class="p-6 flex justify-between items-center border-b border-gray-100"><h2 class="text-xl font-black">Recent machines</h2><a class="text-brand-600 font-black text-sm" href="/admin/machines">View all</a></div>
      <div class="overflow-x-auto"><table class="w-full text-sm">
        <thead class="bg-gray-50 text-gray-500 uppercase tracking-wider text-xs"><tr><th class="text-left p-4">Machine</th><th class="text-left p-4">Status</th><th class="text-left p-4">Actions</th></tr></thead>
        <tbody class="divide-y divide-gray-100">
          <% recentMachines.forEach(m => { %>
            <tr><td class="p-4"><strong class="block text-gray-950"><%= m.title %></strong><small class="text-gray-500"><%= formatDate(m.created_at) %></small></td><td class="p-4"><span class="status-badge <%= m.status %>"><%= statusLabel(m.status) %></span></td><td class="p-4"><div class="flex flex-wrap gap-2"><a class="wpe-admin-btn" href="/admin/machines/<%= m.id %>/preview">Preview</a><a class="wpe-admin-btn secondary" href="/admin/machines/<%= m.id %>/edit">Edit</a><form method="post" action="/admin/machines/<%= m.id %>/delete" data-confirm-delete="Delete this machine listing permanently?"><button class="wpe-admin-btn danger" type="submit">Delete</button></form></div></td></tr>
          <% }) %>
        </tbody>
      </table></div>
    </div>
    <div class="bg-white rounded-[2rem] border border-gray-100 shadow-sm overflow-hidden">
      <div class="p-6 flex justify-between items-center border-b border-gray-100"><h2 class="text-xl font-black">Recent buyer requests</h2><a class="text-brand-600 font-black text-sm" href="/admin/requests">View all</a></div>
      <div class="overflow-x-auto"><table class="w-full text-sm">
        <thead class="bg-gray-50 text-gray-500 uppercase tracking-wider text-xs"><tr><th class="text-left p-4">Buyer</th><th class="text-left p-4">Type</th><th class="text-left p-4">Status</th><th class="text-left p-4"></th></tr></thead>
        <tbody class="divide-y divide-gray-100">
          <% recentRequests.forEach(r => { %>
            <tr><td class="p-4"><strong class="block text-gray-950"><%= r.buyer_name %></strong><small class="text-gray-500"><%= formatDate(r.created_at) %></small></td><td class="p-4"><%= r.request_type === 'contact' ? 'Contact' : 'Buying' %></td><td class="p-4"><span class="status-badge <%= r.status %>"><%= statusLabel(r.status) %></span></td><td class="p-4"><a class="wpe-admin-btn" href="/admin/requests/<%= r.id %>">Review</a></td></tr>
          <% }) %>
        </tbody>
      </table></div>
    </div>
  </section>
  <section class="bg-white rounded-[2rem] border border-gray-100 shadow-sm p-6 mt-6">
    <h2 class="text-xl font-black mb-2">Test email</h2>
    <p class="text-sm text-gray-500 mb-4">Send a test message to confirm Resend / SMTP is configured.</p>
    <form class="flex flex-col sm:flex-row gap-3" method="post" action="/admin/test-email">
      <input class="wpe-input flex-1" type="email" name="to" placeholder="you@example.com" required>
      <button class="px-6 py-3 rounded-full bg-brand-600 text-white font-black hover:bg-brand-700 transition" type="submit">Send test email</button>
    </form>
  </section>
</section>
<%- include('../partials/foot') %>
