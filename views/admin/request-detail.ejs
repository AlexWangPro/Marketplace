<%- include('../partials/head') %>
<% const activeAdmin = 'requests'; const isContact = request.request_type === 'contact'; const isBuying = request.request_type === 'buying'; %>
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-14">
  <div class="rounded-[2rem] bg-gray-950 text-white p-7 md:p-10 mb-6 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
    <div><p class="text-brand-300 font-black tracking-[.2em] uppercase text-xs mb-3">Admin</p><h1 class="text-4xl md:text-5xl font-black tracking-tight mb-3"><%= isContact ? 'Seller Contact Request' : 'Buying Request' %></h1><p class="text-gray-300"><%= request.buyer_name %> · <%= request.buyer_email %></p></div>
    <a class="px-5 py-3 rounded-full bg-white text-gray-950 font-black hover:bg-gray-100 transition" href="/admin/requests">Back to requests</a>
  </div>
  
  <nav class="flex flex-wrap gap-2 mb-8">
    <a class="px-4 py-2 rounded-full text-sm font-black <%= activeAdmin === 'dashboard' ? 'bg-brand-600 text-white' : 'bg-white border border-gray-200 text-gray-700 hover:bg-gray-50' %>" href="/admin">Dashboard</a>
    <a class="px-4 py-2 rounded-full text-sm font-black <%= activeAdmin === 'machines' ? 'bg-brand-600 text-white' : 'bg-white border border-gray-200 text-gray-700 hover:bg-gray-50' %>" href="/admin/machines">Machines</a>
    <a class="px-4 py-2 rounded-full text-sm font-black <%= activeAdmin === 'requests' ? 'bg-brand-600 text-white' : 'bg-white border border-gray-200 text-gray-700 hover:bg-gray-50' %>" href="/admin/requests">Buyer Requests</a>
  </nav>


  <section class="grid lg:grid-cols-[1fr_360px] gap-6">
    <div class="space-y-6">
      <section class="bg-white rounded-[2rem] border border-gray-100 shadow-sm p-6 md:p-8">
        <div class="flex items-start justify-between gap-4 mb-6"><div><p class="text-brand-600 font-black tracking-[.18em] uppercase text-xs mb-2">Buyer</p><h2 class="text-3xl font-black text-gray-950"><%= request.buyer_name %></h2></div><span class="status-badge <%= request.status %>"><%= statusLabel(request.status) %></span></div>
        <div class="grid md:grid-cols-2 xl:grid-cols-4 gap-4">
          <div class="wpe-info"><span>Company</span><strong><%= request.buyer_company || '—' %></strong></div>
          <div class="wpe-info"><span>Email</span><strong><%= request.buyer_email %></strong></div>
          <div class="wpe-info"><span>Phone</span><strong><%= request.buyer_phone || '—' %></strong></div>
          <div class="wpe-info"><span>WhatsApp</span><strong><%= request.buyer_whatsapp || '—' %></strong></div>
          <div class="wpe-info"><span>Country</span><strong><%= request.buyer_country || '—' %></strong></div>
          <div class="wpe-info"><span>Timeline</span><strong><%= request.timeline || '—' %></strong></div>
          <div class="wpe-info"><span>Inspection plan</span><strong><%= request.inspection_plan || '—' %></strong></div>
          <div class="wpe-info"><span>Received</span><strong><%= formatDate(request.created_at) %></strong></div>
        </div>
        <div class="mt-6 bg-gray-50 rounded-3xl p-5"><span class="text-xs font-black uppercase tracking-wider text-gray-400">Message</span><p class="mt-2 text-gray-700 leading-7 whitespace-pre-line"><%= request.message || '—' %></p></div>
      </section>

      <% if (buyerSelectedMachines && buyerSelectedMachines.length) { %>
        <section class="bg-white rounded-[2rem] border border-gray-100 shadow-sm p-6 md:p-8">
          <div class="flex items-start justify-between gap-4 mb-5"><div><p class="text-brand-600 font-black tracking-[.18em] uppercase text-xs mb-2">Buyer selected</p><h2 class="text-2xl font-black text-gray-950">Interested machines</h2></div><small class="bg-brand-50 text-brand-600 rounded-full px-3 py-1 font-black"><%= buyerSelectedMachines.length %> selected</small></div>
          <div class="grid md:grid-cols-2 gap-4">
            <% buyerSelectedMachines.forEach(m => { %>
              <a class="flex gap-4 p-4 rounded-3xl border border-gray-100 bg-gray-50 hover:bg-white hover:shadow-md transition" href="/admin/machines/<%= m.id %>/preview">
                <% if (m.primary_image_id) { %><img class="w-20 h-24 rounded-2xl bg-white object-contain border border-gray-100" src="/images/<%= m.primary_image_id %>" alt=""><% } else { %><span class="w-20 h-24 rounded-2xl bg-white border border-gray-100 flex items-center justify-center text-xs text-gray-400">No image</span><% } %>
                <span><strong class="block text-gray-950"><%= m.title %></strong><small class="text-gray-500"><%= [m.region, m.country, m.city].filter(Boolean).join(' · ') || 'Location not specified' %> · <%= money(m.asking_price, m.currency) %></small></span>
              </a>
            <% }) %>
          </div>
        </section>
      <% } %>

      <% if (isContact && request.machine_title) { %>
        <section class="bg-white rounded-[2rem] border border-gray-100 shadow-sm p-6 md:p-8">
          <div class="flex items-start justify-between gap-4 mb-5"><div><p class="text-brand-600 font-black tracking-[.18em] uppercase text-xs mb-2">Requested machine</p><h2 class="text-2xl font-black text-gray-950"><%= request.machine_title %></h2></div><a class="text-brand-600 font-black text-sm" href="/admin/machines/<%= request.machine_id %>/preview">Preview</a></div>
          <div class="grid md:grid-cols-2 xl:grid-cols-4 gap-4">
            <div class="wpe-info"><span>Public location</span><strong><%= [request.machine_region, request.machine_country, request.machine_city].filter(Boolean).join(' · ') || '—' %></strong></div>
            <div class="wpe-info"><span>Seller</span><strong><%= request.seller_name || '—' %></strong></div>
            <div class="wpe-info"><span>Company</span><strong><%= request.seller_company || '—' %></strong></div>
            <div class="wpe-info"><span>Email</span><strong><%= request.seller_email || '—' %></strong></div>
            <div class="wpe-info"><span>Phone</span><strong><%= request.seller_phone || '—' %></strong></div>
            <div class="wpe-info"><span>WhatsApp</span><strong><%= request.seller_whatsapp || '—' %></strong></div>
            <div class="wpe-info"><span>Preferred contact</span><strong><%= request.seller_preferred_contact || '—' %></strong></div>
            <div class="wpe-info"><span>Exact address</span><strong><%= request.exact_address || '—' %></strong></div>
          </div>
          <pre class="mt-6 bg-gray-950 text-gray-100 rounded-3xl p-5 text-xs whitespace-pre-wrap overflow-x-auto">Buyer: <%= request.buyer_name %> / <%= request.buyer_email %> / <%= request.buyer_whatsapp || request.buyer_phone || 'No phone provided' %>
Seller: <%= request.seller_name || '' %> / <%= request.seller_email || '' %> / <%= request.seller_whatsapp || request.seller_phone || '' %>
Machine: <%= request.machine_title %></pre>
        </section>
      <% } %>

      <% if (isBuying) { %>
        <section class="bg-white rounded-[2rem] border border-gray-100 shadow-sm p-6 md:p-8">
          <div class="mb-5"><p class="text-brand-600 font-black tracking-[.18em] uppercase text-xs mb-2">Requirement</p><h2 class="text-2xl font-black text-gray-950">Target machine</h2></div>
          <div class="grid md:grid-cols-4 gap-4">
            <div class="wpe-info"><span>Target region</span><strong><%= request.target_region || 'Any' %></strong></div>
            <div class="wpe-info"><span>Budget</span><strong><%= request.budget || '—' %></strong></div>
            <div class="wpe-info"><span>Preferred brand</span><strong><%= request.preferred_brand || '—' %></strong></div>
            <div class="wpe-info"><span>Preferred printheads</span><strong><%= request.preferred_printheads || '—' %></strong></div>
          </div>
        </section>

        <section class="bg-white rounded-[2rem] border border-gray-100 shadow-sm p-6 md:p-8">
          <div class="flex items-start justify-between gap-4 mb-5"><div><p class="text-brand-600 font-black tracking-[.18em] uppercase text-xs mb-2">Match</p><h2 class="text-2xl font-black text-gray-950">Machine options</h2></div><small class="bg-brand-50 text-brand-600 rounded-full px-3 py-1 font-black">Select up to 5</small></div>
          <% if (matchedMachines && matchedMachines.length) { %>
            <div class="flex flex-wrap gap-2 mb-5"><% matchedMachines.forEach(m => { %><a class="px-3 py-1 rounded-full bg-green-50 text-green-700 text-xs font-black" href="/admin/machines/<%= m.id %>/preview"><%= m.title %></a><% }) %></div>
          <% } %>
          <form method="post" action="/admin/requests/<%= request.id %>/match" data-match-form>
            <div class="grid md:grid-cols-2 gap-4 mb-5">
              <% candidateMachines.forEach(m => { %>
                <label class="flex gap-4 p-4 rounded-3xl border border-gray-100 bg-gray-50 hover:bg-white hover:shadow-md transition cursor-pointer">
                  <input class="mt-2 accent-brand-600" type="checkbox" name="machine_ids" value="<%= m.id %>" <%= request.matched_machine_ids && request.matched_machine_ids.includes(m.id) ? 'checked' : '' %> data-match-checkbox>
                  <% if (m.primary_image_id) { %><img class="w-20 h-24 rounded-2xl bg-white object-contain border border-gray-100" src="/images/<%= m.primary_image_id %>" alt=""><% } else { %><div class="w-20 h-24 rounded-2xl bg-white border border-gray-100 flex items-center justify-center text-xs text-gray-400">No image</div><% } %>
                  <span><strong class="block text-gray-950"><%= m.title %></strong><small class="text-gray-500"><%= [m.region,m.country,m.city].filter(Boolean).join(' · ') %> · <%= money(m.asking_price, m.currency) %></small></span>
                </label>
              <% }) %>
            </div>
            <p class="text-sm text-gray-500 mb-4">The buyer receives selected machine options with seller contacts. Sellers receive buyer contact information.</p>
            <button class="px-6 py-3 rounded-full bg-brand-600 text-white font-black hover:bg-brand-700 transition" type="submit">Send Match Email</button>
          </form>
        </section>
      <% } %>
    </div>

    <aside class="space-y-6 lg:sticky lg:top-28 self-start">
      <section class="bg-white rounded-[2rem] border border-gray-100 shadow-sm p-6">
        <h2 class="text-xl font-black text-gray-950 mb-5">Admin action</h2>
        <form method="post" action="/admin/requests/<%= request.id %>/update" class="space-y-4">
          <label class="wpe-field">Status<select name="status"><% requestStatuses.forEach(s => { %><option value="<%= s %>" <%= request.status === s ? 'selected' : '' %>><%= statusLabel(s) %></option><% }) %></select></label>
          <label class="wpe-field">Admin notes<textarea name="admin_notes" rows="7"><%= request.admin_notes || '' %></textarea></label>
          <button class="w-full px-6 py-3 rounded-full bg-brand-600 text-white font-black hover:bg-brand-700 transition" type="submit">Update Request</button>
          <% if (isContact && request.machine_title) { %><p class="text-xs text-gray-500 leading-6">Set status to <strong>Contact Shared</strong> to email both buyer and seller. Email: <strong><%= mailConfigured ? 'ready' : 'not configured' %></strong>.</p><% } %>
        </form>
        <form method="post" action="/admin/requests/<%= request.id %>/delete" data-confirm-delete="Delete this buyer request permanently? This cannot be undone." class="mt-4">
          <button class="w-full px-6 py-3 rounded-full bg-red-50 text-red-700 font-black hover:bg-red-100 transition" type="submit">Delete Request</button>
        </form>
      </section>

      <section class="bg-white rounded-[2rem] border border-gray-100 shadow-sm p-6">
        <h2 class="text-xl font-black text-gray-950 mb-5">Email log</h2>
        <% if (isContact) { %>
          <div class="wpe-email-log"><span>Buyer receives seller contact</span><strong><%= request.contact_buyer_email_sent_at ? formatDate(request.contact_buyer_email_sent_at) : 'Not sent' %></strong><% if (request.contact_buyer_email_error) { %><small><%= request.contact_buyer_email_error %></small><% } %></div>
          <div class="wpe-email-log"><span>Seller receives buyer contact</span><strong><%= request.contact_seller_email_sent_at ? formatDate(request.contact_seller_email_sent_at) : 'Not sent' %></strong><% if (request.contact_seller_email_error) { %><small><%= request.contact_seller_email_error %></small><% } %></div>
          <div class="wpe-email-log"><span>Overall contact release</span><strong><%= request.contact_email_sent_at ? formatDate(request.contact_email_sent_at) : 'Incomplete' %></strong><% if (request.contact_email_error) { %><small><%= request.contact_email_error %></small><% } %></div>
          <div class="grid gap-2 mt-4">
            <form method="post" action="/admin/requests/<%= request.id %>/send-contact-email"><input type="hidden" name="recipient" value="buyer"><button class="w-full px-4 py-2 rounded-full bg-gray-100 text-gray-700 font-black hover:bg-gray-200 transition" type="submit">Send to Buyer</button></form>
            <form method="post" action="/admin/requests/<%= request.id %>/send-contact-email"><input type="hidden" name="recipient" value="seller"><button class="w-full px-4 py-2 rounded-full bg-gray-100 text-gray-700 font-black hover:bg-gray-200 transition" type="submit">Send to Seller</button></form>
            <form method="post" action="/admin/requests/<%= request.id %>/send-contact-email"><input type="hidden" name="recipient" value="both"><button class="w-full px-4 py-2 rounded-full bg-brand-600 text-white font-black hover:bg-brand-700 transition" type="submit">Send Both</button></form>
          </div>
        <% } %>
        <% if (isBuying) { %>
          <div class="wpe-email-log"><span>Buyer receives matched sellers</span><strong><%= request.match_buyer_email_sent_at ? formatDate(request.match_buyer_email_sent_at) : 'Not sent' %></strong><% if (request.match_buyer_email_error) { %><small><%= request.match_buyer_email_error %></small><% } %></div>
          <div class="wpe-email-log"><span>Sellers receive buyer contact</span><strong><%= request.match_seller_email_sent_at ? formatDate(request.match_seller_email_sent_at) : 'Not sent' %></strong><% if (request.match_seller_email_error) { %><small><%= request.match_seller_email_error %></small><% } %></div>
          <div class="wpe-email-log"><span>Overall match email</span><strong><%= request.match_email_sent_at ? formatDate(request.match_email_sent_at) : 'Incomplete' %></strong><% if (request.match_email_error) { %><small><%= request.match_email_error %></small><% } %></div>
        <% } %>
      </section>
    </aside>
  </section>
</section>
<%- include('../partials/foot') %>
