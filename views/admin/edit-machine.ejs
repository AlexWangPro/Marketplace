<%- include('../partials/head') %>
<% const activeAdmin = 'machines'; %>
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-14">
  <div class="rounded-[2rem] bg-gray-950 text-white p-7 md:p-10 mb-6 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
    <div><p class="text-brand-300 font-black tracking-[.2em] uppercase text-xs mb-3">Admin</p><h1 class="text-4xl md:text-5xl font-black tracking-tight mb-3">Edit Machine</h1><p class="text-gray-300">Update public listing details, private seller contact, images, and status.</p></div>
    <div class="flex flex-wrap gap-2"><a class="px-5 py-3 rounded-full bg-brand-600 text-white font-black hover:bg-brand-700 transition" href="/admin/machines/<%= machine.id %>/preview">Preview listing</a><a class="px-5 py-3 rounded-full bg-white text-gray-950 font-black hover:bg-gray-100 transition" href="/admin/machines">Back</a><form method="post" action="/admin/machines/<%= machine.id %>/delete" data-confirm-delete="Delete this machine listing permanently? This cannot be undone."><button class="px-5 py-3 rounded-full bg-red-600 text-white font-black hover:bg-red-700 transition" type="submit">Delete Listing</button></form></div>
  </div>
  
  <nav class="flex flex-wrap gap-2 mb-8">
    <a class="px-4 py-2 rounded-full text-sm font-black <%= activeAdmin === 'dashboard' ? 'bg-brand-600 text-white' : 'bg-white border border-gray-200 text-gray-700 hover:bg-gray-50' %>" href="/admin">Dashboard</a>
    <a class="px-4 py-2 rounded-full text-sm font-black <%= activeAdmin === 'machines' ? 'bg-brand-600 text-white' : 'bg-white border border-gray-200 text-gray-700 hover:bg-gray-50' %>" href="/admin/machines">Machines</a>
    <a class="px-4 py-2 rounded-full text-sm font-black <%= activeAdmin === 'requests' ? 'bg-brand-600 text-white' : 'bg-white border border-gray-200 text-gray-700 hover:bg-gray-50' %>" href="/admin/requests">Buyer Requests</a>
  </nav>

  <% if (errors && errors.length) { %><div class="bg-red-50 border border-red-200 text-red-700 rounded-3xl p-5 text-sm font-semibold mb-6"><% errors.forEach(e => { %><p><%= e %></p><% }) %></div><% } %>

  <form class="space-y-6 pb-20" method="post" action="/admin/machines/<%= machine.id %>/edit" enctype="multipart/form-data">
    <section class="bg-white rounded-[2rem] border border-gray-100 shadow-sm p-6 md:p-8">
      <h2 class="text-2xl font-black text-gray-950 mb-5">Publication status</h2>
      <div class="grid md:grid-cols-3 gap-4">
        <label class="wpe-field">Status<select name="status"><% machineStatuses.forEach(s => { %><option value="<%= s %>" <%= machine.status === s ? 'selected' : '' %>><%= statusLabel(s) %></option><% }) %></select></label>
        <label class="wpe-field">Featured<select name="featured"><option value="">No</option><option value="on" <%= machine.featured ? 'selected' : '' %>>Yes</option></select></label>
        <label class="wpe-field">Current public URL<input value="/machine/<%= machine.slug %>" disabled></label>
      </div>
      <label class="wpe-field mt-4">Admin notes<textarea name="admin_notes" rows="4"><%= machine.admin_notes || '' %></textarea></label>
    </section>

    <section class="bg-white rounded-[2rem] border border-gray-100 shadow-sm p-6 md:p-8">
      <h2 class="text-2xl font-black text-gray-950 mb-2">Private seller contact</h2>
      <p class="text-sm text-gray-500 mb-5">This section is never displayed publicly. Use it for admin review and approved buyer introductions.</p>
      <div class="grid md:grid-cols-2 gap-4">
        <label class="wpe-field">Seller name<input name="seller_name" value="<%= machine.seller_name || '' %>"></label>
        <label class="wpe-field">Company<input name="seller_company" value="<%= machine.seller_company || '' %>"></label>
        <label class="wpe-field">Email<input name="seller_email" value="<%= machine.seller_email || '' %>"></label>
        <label class="wpe-field">Phone<input name="seller_phone" value="<%= machine.seller_phone || '' %>"></label>
        <label class="wpe-field">WhatsApp<input name="seller_whatsapp" value="<%= machine.seller_whatsapp || '' %>"></label>
        <label class="wpe-field">Preferred contact<input name="seller_preferred_contact" value="<%= machine.seller_preferred_contact || '' %>"></label>
        <label class="wpe-field md:col-span-2">Exact address<input name="exact_address" value="<%= machine.exact_address || '' %>"></label>
      </div>
    </section>

    <section class="bg-white rounded-[2rem] border border-gray-100 shadow-sm p-6 md:p-8">
      <h2 class="text-2xl font-black text-gray-950 mb-5">Public listing</h2>
      <div class="grid md:grid-cols-2 gap-4">
        <label class="wpe-field md:col-span-2">Title<input name="title" value="<%= machine.title || '' %>" required></label>
        <label class="wpe-field">Brand<input name="brand" value="<%= machine.brand || '' %>"></label>
        <label class="wpe-field">Model<input name="model" value="<%= machine.model || '' %>"></label>
        <label class="wpe-field">Production year<input name="production_year" value="<%= machine.production_year || '' %>"></label>
        <label class="wpe-field">Purchase year<input name="purchase_year" value="<%= machine.purchase_year || '' %>"></label>
        <label class="wpe-field">Printhead type<input name="printhead_type" value="<%= machine.printhead_type || '' %>"></label>
        <label class="wpe-field">Printhead count<input type="number" name="printhead_count" value="<%= machine.printhead_count || '' %>"></label>
        <label class="wpe-field">Working status<input name="working_status" value="<%= machine.working_status || '' %>"></label>
        <label class="wpe-field">Asking price<input type="number" step="0.01" name="asking_price" value="<%= machine.asking_price || '' %>"></label>
        <label class="wpe-field">Currency<input name="currency" value="<%= machine.currency || 'USD' %>"></label>
      </div>
      <label class="flex gap-3 items-start text-sm text-gray-600 mt-5"><input class="mt-1 accent-brand-600" type="checkbox" name="price_negotiable" <%= machine.price_negotiable ? 'checked' : '' %>> Price negotiable</label>
      <label class="wpe-field mt-4">Machine description and condition<textarea name="details" rows="8"><%= machine.details || machine.condition_summary || machine.usage_history || '' %></textarea></label>
      <div class="grid md:grid-cols-2 gap-4 mt-4"><label class="wpe-field">Known defects<textarea name="known_defects" rows="4"><%= machine.known_defects || '' %></textarea></label><label class="wpe-field">Accessories<textarea name="accessories" rows="4"><%= machine.accessories || '' %></textarea></label></div>
      <label class="wpe-field mt-4">Video URL<input name="video_url" value="<%= machine.video_url || '' %>"></label>
    </section>

    <section class="bg-white rounded-[2rem] border border-gray-100 shadow-sm p-6 md:p-8">
      <h2 class="text-2xl font-black text-gray-950 mb-5">Public location</h2>
      <div class="grid md:grid-cols-3 gap-4">
        <label class="wpe-field">Region<select name="region"><option value="">Select region</option><% regions.forEach(r => { %><option value="<%= r %>" <%= machine.region === r ? 'selected' : '' %>><%= r %></option><% }) %></select></label>
        <label class="wpe-field">Country<input name="country" value="<%= machine.country || '' %>"></label>
        <label class="wpe-field">City<input name="city" value="<%= machine.city || '' %>"></label>
      </div>
    </section>

    <section class="bg-white rounded-[2rem] border border-gray-100 shadow-sm p-6 md:p-8">
      <h2 class="text-2xl font-black text-gray-950 mb-5">Images</h2>
      <% if (images && images.length) { %>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
          <% images.forEach(img => { %>
            <div class="rounded-3xl border border-gray-100 bg-gray-50 p-3">
              <img class="w-full aspect-[4/5] object-contain rounded-2xl bg-white" src="/images/<%= img.id %>" alt="">
              <div class="flex justify-between items-center mt-3 text-xs"><span><%= img.is_primary ? 'Primary' : 'Image' %></span><form method="post" action="/admin/machines/<%= machine.id %>/images/<%= img.id %>/delete" data-confirm-delete="Delete this image?"><button class="text-red-600 font-black" type="submit">Delete</button></form></div>
            </div>
          <% }) %>
        </div>
      <% } %>
      <label class="wpe-field">Add images<input type="file" name="images" multiple accept="image/jpeg,image/png,image/webp,image/gif" data-image-input></label>
      <div data-image-error class="image-error"></div>
      <div data-image-preview class="image-preview-grid mt-5"></div>
    </section>

    <div class="flex flex-col sm:flex-row justify-end gap-3">
      <a class="px-6 py-3 rounded-full border border-gray-200 bg-white text-gray-700 font-black text-center hover:bg-gray-50 transition" href="/admin/machines">Cancel</a>
      <button class="px-8 py-3 rounded-full bg-brand-600 text-white font-black hover:bg-brand-700 shadow-lg shadow-brand-600/20 transition" type="submit">Save changes</button>
    </div>
  </form>
</section>
<%- include('../partials/foot') %>
