<%- include('../partials/head') %>
<% const activeAdmin = 'machines'; const currentStatus = filters.status || ''; %>
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-14">
  <div class="rounded-[2rem] bg-gray-950 text-white p-7 md:p-10 mb-6 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
    <div><p class="text-brand-300 font-black tracking-[.2em] uppercase text-xs mb-3">Admin</p><h1 class="text-4xl md:text-5xl font-black tracking-tight mb-3">Machines</h1><p class="text-gray-300">Review seller submissions, manage public status, and keep listings clean.</p></div>
    <a class="px-5 py-3 rounded-full bg-white text-gray-950 font-black hover:bg-gray-100 transition" href="/admin">Dashboard</a>
  </div>
  
  <nav class="flex flex-wrap gap-2 mb-8">
    <a class="px-4 py-2 rounded-full text-sm font-black <%= activeAdmin === 'dashboard' ? 'bg-brand-600 text-white' : 'bg-white border border-gray-200 text-gray-700 hover:bg-gray-50' %>" href="/admin">Dashboard</a>
    <a class="px-4 py-2 rounded-full text-sm font-black <%= activeAdmin === 'machines' ? 'bg-brand-600 text-white' : 'bg-white border border-gray-200 text-gray-700 hover:bg-gray-50' %>" href="/admin/machines">Machines</a>
    <a class="px-4 py-2 rounded-full text-sm font-black <%= activeAdmin === 'requests' ? 'bg-brand-600 text-white' : 'bg-white border border-gray-200 text-gray-700 hover:bg-gray-50' %>" href="/admin/requests">Buyer Requests</a>
  </nav>


  <section class="bg-white rounded-[2rem] border border-gray-100 shadow-sm p-5 mb-6">
    <div class="flex flex-wrap gap-2 mb-5" aria-label="Machine status filters">
      <a class="px-4 py-2 rounded-full text-sm font-black <%= !currentStatus ? 'bg-brand-600 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200' %>" href="/admin/machines">All</a>
      <% ['pending_review','available','reserved','sold','archived','rejected'].forEach(s => { %>
        <a class="px-4 py-2 rounded-full text-sm font-black <%= currentStatus === s ? 'bg-brand-600 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200' %>" href="/admin/machines?status=<%= s %>"><%= statusLabel(s) %></a>
      <% }) %>
    </div>
    <form class="grid md:grid-cols-12 gap-3" method="get" action="/admin/machines">
      <input class="wpe-input md:col-span-5" type="search" name="q" placeholder="Search machine, seller, email, country..." value="<%= filters.q || '' %>">
      <select class="wpe-input md:col-span-3" name="region"><option value="">All regions</option><% regions.forEach(r => { %><option value="<%= r %>" <%= filters.region === r ? 'selected' : '' %>><%= r %></option><% }) %></select>
      <% if (filters.status) { %><input type="hidden" name="status" value="<%= filters.status %>"><% } %>
      <button class="md:col-span-2 rounded-2xl bg-brand-600 text-white font-black hover:bg-brand-700 transition" type="submit">Search</button>
      <a class="md:col-span-2 rounded-2xl bg-gray-100 text-gray-700 font-black hover:bg-gray-200 transition flex items-center justify-center" href="/admin/machines">Reset</a>
    </form>
  </section>

  <section class="bg-white rounded-[2rem] border border-gray-100 shadow-sm overflow-hidden">
    <% if (!machines.length) { %>
      <div class="p-10 text-center"><h2 class="text-2xl font-black">No machines found.</h2><p class="text-gray-500 mt-2">Try another filter or clear the search.</p></div>
    <% } else { %>
      <div class="overflow-x-auto"><table class="w-full text-sm">
        <thead class="bg-gray-50 text-gray-500 uppercase tracking-wider text-xs"><tr><th class="text-left p-4">Machine</th><th class="text-left p-4">Seller</th><th class="text-left p-4">Location</th><th class="text-left p-4">Price</th><th class="text-left p-4">Status</th><th class="text-left p-4">Actions</th></tr></thead>
        <tbody class="divide-y divide-gray-100">
          <% machines.forEach(m => { %>
            <tr class="align-top">
              <td class="p-4 min-w-[320px]">
                <div class="flex gap-4">
                  <% if (m.primary_image_id) { %><img class="w-16 h-20 rounded-2xl object-contain bg-gray-100 border border-gray-100" src="/images/<%= m.primary_image_id %>" alt=""><% } else { %><div class="w-16 h-20 rounded-2xl bg-gray-100 flex items-center justify-center text-xs font-black text-gray-400">WPE</div><% } %>
                  <div><strong class="block text-gray-950"><%= m.title %></strong><small class="block text-gray-500"><%= [m.brand,m.model,m.printhead_type].filter(Boolean).join(' · ') || 'Specs pending' %></small><small class="block text-gray-400">Submitted <%= formatDate(m.created_at) %></small></div>
                </div>
              </td>
              <td class="p-4"><strong class="block"><%= m.seller_name || '—' %></strong><small class="text-gray-500"><%= m.seller_email || '' %></small></td>
              <td class="p-4"><%= [m.region,m.country,m.city].filter(Boolean).join(' · ') || '—' %></td>
              <td class="p-4"><%= money(m.asking_price, m.currency) %></td>
              <td class="p-4"><span class="status-badge <%= m.status %>"><%= statusLabel(m.status) %></span></td>
              <td class="p-4 min-w-[260px]">
                <div class="flex flex-wrap gap-2 mb-2"><a class="wpe-admin-btn" href="/admin/machines/<%= m.id %>/preview">Preview</a><a class="wpe-admin-btn secondary" href="/admin/machines/<%= m.id %>/edit">Edit</a></div>
                <form class="flex gap-2 mb-2" method="post" action="/admin/machines/<%= m.id %>/status">
                  <select class="wpe-input compact" name="status" aria-label="Change machine status"><% machineStatuses.forEach(s => { %><option value="<%= s %>" <%= m.status === s ? 'selected' : '' %>><%= statusLabel(s) %></option><% }) %></select>
                  <button class="wpe-admin-btn secondary" type="submit">Update</button>
                </form>
                <form method="post" action="/admin/machines/<%= m.id %>/delete" data-confirm-delete="Delete this machine listing permanently? This cannot be undone.">
                  <button class="wpe-admin-btn danger" type="submit">Delete</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table></div>
    <% } %>
  </section>
</section>
<%- include('../partials/foot') %>
