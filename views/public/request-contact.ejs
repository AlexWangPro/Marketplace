<%- include('../partials/head') %>
<% const selectedMachineIds = Array.isArray(form.selected_machine_ids) ? form.selected_machine_ids.map(String) : (form.selected_machine_ids ? [String(form.selected_machine_ids)] : [String(machine.id)]); %>
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
  <div class="max-w-3xl">
    <p class="text-brand-600 font-black tracking-[.2em] uppercase text-xs mb-4">Request Seller Contact</p>
    <h1 class="text-4xl md:text-6xl font-black tracking-tight text-gray-950 mb-6"><%= machine.title %></h1>
    <p class="text-lg text-gray-600 leading-8">Admin reviews buyer requests before releasing seller contact information. You may select up to <%= buyerMachineSelectionLimit %> machines in one request.</p>
  </div>
</section>
<% if (errors && errors.length) { %>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mb-6">
    <div class="bg-red-50 border border-red-200 text-red-700 rounded-3xl p-5 text-sm font-semibold space-y-1"><% errors.forEach(e => { %><p><%= e %></p><% }) %></div>
  </div>
<% } %>

<form class="wpe-large-form max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-24 space-y-8" method="post" action="<%= localPath('/machine/' + machine.slug + '/request-contact') %>">
  <section class="bg-white rounded-[2rem] border border-gray-100 shadow-sm p-6 md:p-8">
    <h2 class="text-2xl font-black text-gray-950 mb-5">Buyer contact</h2>
    <div class="grid md:grid-cols-2 gap-4">
      <label class="wpe-field">Your name *<input name="buyer_name" value="<%= form.buyer_name || '' %>" required></label>
      <label class="wpe-field">Company<input name="buyer_company" value="<%= form.buyer_company || '' %>"></label>
      <label class="wpe-field">Email *<input type="email" name="buyer_email" value="<%= form.buyer_email || '' %>" required></label>
      <label class="wpe-field">Phone *<input name="buyer_phone" value="<%= form.buyer_phone || '' %>" required></label>
      <label class="wpe-field">WhatsApp<input name="buyer_whatsapp" value="<%= form.buyer_whatsapp || '' %>"></label>
      <label class="wpe-field">Your country *<input name="buyer_country" value="<%= form.buyer_country || '' %>" required></label>
      <label class="wpe-field">Purchase timeline *<select name="timeline" required><option value="">Select timeline</option><% purchaseTimelineOptions.forEach(item => { %><option value="<%= item %>" <%= form.timeline === item ? 'selected' : '' %>><%= item %></option><% }) %></select></label>
      <label class="wpe-field">Inspection plan<select name="inspection_plan"><option value="">Select option</option><% inspectionPlans.forEach(plan => { %><option value="<%= plan %>" <%= form.inspection_plan === plan ? 'selected' : '' %>><%= plan %></option><% }) %></select></label>
    </div>
    <label class="wpe-field mt-4">Message<textarea name="message" rows="5"><%= form.message || '' %></textarea></label>
  </section>

  <% if (machineOptions && machineOptions.length) { %>
    <section class="bg-white rounded-[2rem] border border-gray-100 shadow-sm p-6 md:p-8">
      <div class="flex items-start justify-between gap-4 mb-5">
        <div><h2 class="text-2xl font-black text-gray-950">Machines to request</h2><p class="text-sm text-gray-500 mt-1">Select the listing above, or include up to <%= buyerMachineSelectionLimit %> machines you want seller contact for.</p></div>
        <span class="shrink-0 bg-brand-50 text-brand-600 px-3 py-1 rounded-full text-xs font-black">Max <%= buyerMachineSelectionLimit %></span>
      </div>
      <div class="grid md:grid-cols-2 gap-4" data-selection-limit="<%= buyerMachineSelectionLimit %>" data-selection-message="You can select up to <%= buyerMachineSelectionLimit %> machines only.">
        <% machineOptions.forEach(m => { %>
          <label class="relative flex gap-4 p-4 rounded-3xl border border-gray-100 bg-gray-50 hover:bg-white hover:shadow-md transition cursor-pointer">
            <input class="mt-2 accent-brand-600" type="checkbox" name="selected_machine_ids" value="<%= m.id %>" <%= selectedMachineIds.includes(String(m.id)) ? 'checked' : '' %> data-selection-checkbox>
            <span class="w-20 h-24 rounded-2xl bg-white overflow-hidden flex items-center justify-center border border-gray-100 shrink-0">
              <% if (m.primary_image_id) { %><img src="/images/<%= m.primary_image_id %>" alt="<%= m.title %>" class="w-full h-full object-contain p-1"><% } else { %><span class="text-xs text-gray-400">No image</span><% } %>
            </span>
            <span class="min-w-0">
              <strong class="block text-sm font-black text-gray-950 leading-snug"><%= m.title %></strong>
              <small class="block text-xs text-gray-500 mt-1"><%= [m.region, m.country, m.city].filter(Boolean).join(' · ') || 'Location not specified' %></small>
              <em class="block text-xs not-italic text-brand-600 font-bold mt-2"><%= money(m.asking_price, m.currency) %> · <%= statusLabel(m.status) %></em>
            </span>
          </label>
        <% }) %>
      </div>
    </section>
  <% } %>

  <section class="bg-white rounded-[2rem] border border-gray-100 shadow-sm p-6 md:p-8">
    <label class="flex gap-3 items-start text-sm text-gray-600"><input class="mt-1 accent-brand-600" type="checkbox" name="verification_ack" required <%= form.verification_ack ? 'checked' : '' %>> I understand that Wall Printer Exchange is not the seller and that I must verify machine condition, ownership, payment, and logistics before purchase.</label>
  </section>

  <div class="flex flex-col sm:flex-row justify-end gap-3">
    <a class="px-6 py-3 rounded-full border border-gray-200 bg-white text-gray-700 font-black text-center hover:bg-gray-50 transition" href="<%= localPath('/machine/' + machine.slug) %>">Cancel</a>
    <button class="px-8 py-3 rounded-full bg-brand-600 text-white font-black hover:bg-brand-700 shadow-lg shadow-brand-600/20 transition" type="submit">Request seller contact</button>
  </div>
</form>
<%- include('../partials/foot') %>
