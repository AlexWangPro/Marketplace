<%- include('../partials/head') %>
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 md:py-20">
  <div class="max-w-3xl">
    <p class="text-brand-600 font-black tracking-[.2em] uppercase text-xs mb-4"><%= t('check.eyebrow') %></p>
    <h1 class="text-4xl md:text-6xl font-black tracking-tight text-gray-950 mb-6"><%= t('check.h1') %></h1>
    <p class="text-lg text-gray-600 leading-8"><%= t('check.text') %></p>
  </div>
</section>
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12 grid md:grid-cols-2 gap-6">
  <article class="bg-white p-7 rounded-[2rem] border border-gray-100 shadow-sm"><span class="text-sm font-black text-brand-600"><%= t('check.identity') %></span><h2 class="text-2xl font-black mt-3 mb-4"><%= t('check.sellerOwnership') %></h2><ul class="space-y-3 text-gray-600 leading-7"><li><%= t('check.identity1') %></li><li><%= t('check.identity2') %></li><li><%= t('check.identity3') %></li></ul></article>
  <article class="bg-white p-7 rounded-[2rem] border border-gray-100 shadow-sm"><span class="text-sm font-black text-brand-600"><%= t('check.condition') %></span><h2 class="text-2xl font-black mt-3 mb-4"><%= t('check.machinePrintheads') %></h2><ul class="space-y-3 text-gray-600 leading-7"><li><%= t('check.condition1') %></li><li><%= t('check.condition2') %></li><li><%= t('check.condition3') %></li></ul></article>
  <article class="bg-white p-7 rounded-[2rem] border border-gray-100 shadow-sm"><span class="text-sm font-black text-brand-600"><%= t('check.package') %></span><h2 class="text-2xl font-black mt-3 mb-4"><%= t('check.accessoriesHistory') %></h2><ul class="space-y-3 text-gray-600 leading-7"><li><%= t('check.package1') %></li><li><%= t('check.package2') %></li><li><%= t('check.package3') %></li></ul></article>
  <article class="bg-white p-7 rounded-[2rem] border border-gray-100 shadow-sm"><span class="text-sm font-black text-brand-600"><%= t('check.terms') %></span><h2 class="text-2xl font-black mt-3 mb-4"><%= t('check.paymentLogistics') %></h2><ul class="space-y-3 text-gray-600 leading-7"><li><%= t('check.terms1') %></li><li><%= t('check.terms2') %></li><li><%= t('check.terms3') %></li></ul></article>
</section>
<section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">
  <div class="bg-gray-950 text-white rounded-[2rem] p-8 md:p-10"><h2 class="text-3xl font-black mb-4"><%= t('check.note.h2') %></h2><p class="text-gray-300 leading-8"><%= t('check.note.text') %></p></div>
</section>
<%- include('../partials/foot') %>